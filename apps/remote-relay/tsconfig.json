{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
		"paths": {
			"@origin/remote-control": ["../../packages/remote-control/src/index.ts"],
			"@origin/remote-control/*": ["../../packages/remote-control/src/*"],
			"@origin/remote-desktop": ["../../packages/remote-desktop/src/index.ts"],
			"@origin/remote-desktop/protocol": ["../../packages/remote-desktop/src/protocol-entry.ts"],
			"@origin/remote-desktop/*": ["../../packages/remote-desktop/src/*"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
